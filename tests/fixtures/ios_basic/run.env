# Fixture run.env for the App Release test suite.
#
# Mirrors the shape AppReleaseRunContext.write_run_env() produces
# (addons/app_release/core/run_context_writer.gd) for a TestFlight/iOS target
# built from the export_presets.cfg fixture in this same directory.
#
# PROJECT_ROOT is a placeholder — shell tests substitute it with their tmpdir
# before sourcing/using this file, since release.sh requires an absolute path
# it can `cd` into.
TARGET_ID="testflight_ios"
TARGET_LABEL="TestFlight (iOS)"
PLATFORM="ios"
STORE="testflight"
LANE="beta"
EXPORT_PRESET="iOS"
BUILD_MODE="REGENERATE_NATIVE_PROJECT"
ARTIFACT_PATH="build/ios/App Release.ipa"
PLAY_TRACK=""
APP_IDENTIFIER="com.example.apprelease"
ANDROID_PACKAGE_NAME="com.example.apprelease"
APPLE_TEAM_ID="ABCDE12345"
NATIVE_PROJECT_PATH="ios/App Release.xcodeproj"
XCODE_SCHEME="App Release"
IOS_EXPORT_OPTIONS="ios/ExportOptions.plist"
PCK_PATH="ios/App Release.pck"
PROJECT_ROOT="__ROOT__"
GODOT_BIN="godot"
LOGS_DIR="logs"
RELEASE_NOTES_DIR="release-notes"
PLAY_CHANGELOGS_DIR="fastlane/metadata/android/en-US/changelogs"
KEEP_LOGS="20"
EXTRA_PATH=""
DEBUG_BUILD="0"
VERSION="1.0.0"
BUILD="1"
RELEASE_NOTES_FILE=""
RELEASE_GROUPS=""
IOS_SKIP_BUILD_PROCESSING_WAIT="0"
