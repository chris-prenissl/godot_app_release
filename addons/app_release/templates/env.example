# Copy to fastlane/.env and fill in. fastlane/.env must stay out of git.
#
# Only the sections for the stores you actually ship to are required. Key files
# (.p8, service-account .json) belong outside the repository.

# --- App Store Connect (TestFlight + App Store lanes, and both Fetch buttons) ---
# Create an API key at https://appstoreconnect.apple.com/access/integrations/api
ASC_KEY_ID=ABC123DEFG
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/Users/you/keys/AuthKey_ABC123DEFG.p8

# --- Firebase App Distribution ---
# App id from the Firebase console, or from google-services.json.
FIREBASE_APP_ID_ANDROID=1:000000000000:android:0000000000000000000000
# Service account json with the "Firebase App Distribution Admin" role.
# Preferred. Leave empty to fall back to the cached `firebase login` session.
FIREBASE_SERVICE_CREDENTIALS=
# Tester groups are not configured here — use the "Test groups" field in the
# Release panel.

# --- Google Play ---
# Service account json, see https://docs.fastlane.tools/actions/supply/#setup
PLAY_JSON_KEY_PATH=/Users/you/keys/play-service-account.json
